<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7FAF2">

    <TextView
        android:id="@+id/txtTituloMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ruta de Recolección Óptima"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="#2F6B3A"
        android:gravity="center"
        android:padding="16dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Fragmento de Google Maps -->
        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Botón de Actualizar Flotante -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnActualizarRuta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:contentDescription="Actualizar Ruta"
            android:src="@android:drawable/stat_notify_sync"
            android:backgroundTint="#FFFFFF"
            app:tint="#2F6B3A"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/menuInferior"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="8dp">

        <Button
            android:id="@+id/btnIrRetiro"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="VOLVER AL REGISTRO"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2F6B3A" />

        <Button
            android:id="@+id/btnOptimizarRuta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="OPTIMIZAR RUTA"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7BAF6F" />

    </LinearLayout>

</LinearLayout>
